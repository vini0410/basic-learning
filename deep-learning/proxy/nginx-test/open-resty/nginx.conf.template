worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include /usr/local/openresty/nginx/conf/mime.types;
    default_type application/octet-stream;

    access_log /dev/stdout;
    error_log /dev/stderr warn;

    sendfile on;

    keepalive_timeout 65;

    # Dicionário de memória compartilhada para armazenar as métricas
    lua_shared_dict prometheus_metrics 10M;

    init_worker_by_lua_block {
        -- Inicializa a biblioteca do prometheus
        prometheus = require("prometheus").init("prometheus_metrics")
        
        -- Registra o contador de requisições com labels customizadas (host, status, path, method)
        metric_requests = prometheus:counter(
            "nginx_http_requests_total", 
            "Number of HTTP requests by status, path and method", 
            {"host", "status", "path", "method"}
        )
        
        -- Registra o histograma de latência das requisições por rota/path
        metric_latency = prometheus:histogram(
            "nginx_http_request_duration_seconds", 
            "HTTP request latency in seconds by path", 
            {"host", "path"}
        )
    }

    log_by_lua_block {
        local path = ngx.var.uri
        -- Ignora as rotas de telemetria internas para não poluir as métricas
        if path ~= "/metrics" and path ~= "/nginx_status" then
            local status = tostring(ngx.status)
            local method = ngx.var.request_method
            local host = ngx.var.host or ""

            metric_requests:inc(1, {host, status, path, method})
            metric_latency:observe(tonumber(ngx.var.request_time), {host, path})
        end
    }

    upstream backend {
        server ${UPSTREAM_HOST}:${UPSTREAM_PORT};
    }

    server {
        listen 8081;
        server_name _;

        location /nginx_status {
            stub_status on;
            access_log off;
            allow all;
        }

        # Endpoint exposto para exportação das métricas customizadas do Lua
        location /metrics {
            default_type 'text/plain';
            content_by_lua_block {
                prometheus:collect()
            }
        }

        location / {
            proxy_pass http://backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header x-real-ip $remote_addr;
            proxy_set_header x-forward $proxy_add_x_forwarded_for;
            add_header x-proxy-flavour openresty always;
        }
    }
}