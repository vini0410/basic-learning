worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include /usr/local/openresty/nginx/conf/mime.types;
    default_type application/octet-stream;

    access_log /dev/stdout;
    error_log /dev/stderr warn;

    sendfile on;

    keepalive_timeout 65;

    # Resolver DNS interno do Docker — necessário para o otlp_exporter.lua (resty.http)
    # resolver nomes de serviço como "otel-collector" dentro do contexto do timer/cosocket
    resolver 127.0.0.11 ipv6=off valid=10s;

    # Dicionário para acumulação dos contadores enviados via OTLP HTTP (push)
    # Chaves: "req:{status}:{path}:{method}" e "dur_sum/count:{path}"
    lua_shared_dict otlp_metrics 5M;

    init_worker_by_lua_block {
        -- ── OTLP Exporter (push direto para o OTel Collector) ────────────────
        -- Carrega o módulo e agenda o timer de flush (apenas no worker 0)
        local otlp = require("otlp_exporter")
        otlp.init_timer()
    }

    log_by_lua_block {
        local path = ngx.var.uri

        local status   = tostring(ngx.status)
        local method   = ngx.var.request_method
        local duration = tonumber(ngx.var.request_time)

        -- Alimenta os contadores do OTLP exporter (shared dict) — enviados via push
        local otlp = require("otlp_exporter")
        otlp.record(status, path, method, duration)
    }

    upstream backend {
        server ${UPSTREAM_HOST}:${UPSTREAM_PORT};
    }

    server {
        listen 8081;
        server_name _;

        location / {
            proxy_pass http://backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header x-real-ip $remote_addr;
            proxy_set_header x-forward $proxy_add_x_forwarded_for;
            add_header x-proxy-flavour openresty always;
        }
    }
}