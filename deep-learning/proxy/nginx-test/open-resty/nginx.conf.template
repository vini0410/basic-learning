worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include /usr/local/openresty/nginx/conf/mime.types;
    default_type application/octet-stream;

    access_log /dev/stdout;
    error_log /dev/stderr warn;

    sendfile on;

    keepalive_timeout 65;

    # Dicionário para as métricas Prometheus (endpoint /metrics)
    lua_shared_dict prometheus_metrics 10M;

    # Dicionário para acumulação de contadores enviados via OTLP HTTP
    # Chaves: "req:{status}:{path}:{method}" e "dur_sum/count:{path}"
    lua_shared_dict otlp_metrics 5M;

    init_worker_by_lua_block {
        -- ── Prometheus (endpoint /metrics local) ──────────────────────────────
        prometheus = require("prometheus").init("prometheus_metrics")

        metric_requests = prometheus:counter(
            "nginx_http_requests_total",
            "Number of HTTP requests by status, path and method",
            {"host", "status", "path", "method"}
        )

        metric_latency = prometheus:histogram(
            "nginx_http_request_duration_seconds",
            "HTTP request latency in seconds by path",
            {"host", "path"}
        )

        -- ── OTLP Exporter (push direto para o OTel Collector) ────────────────
        -- Carrega o módulo e agenda o timer de flush (apenas no worker 0)
        local otlp = require("otlp_exporter")
        otlp.init_timer()
    }

    log_by_lua_block {
        local path = ngx.var.uri

        -- Ignora rotas internas de telemetria para não poluir as métricas
        if path ~= "/metrics" and path ~= "/nginx_status" then
            local status   = tostring(ngx.status)
            local method   = ngx.var.request_method
            local host     = ngx.var.host or ""
            local duration = tonumber(ngx.var.request_time)

            -- Atualiza métricas Prometheus (endpoint /metrics)
            metric_requests:inc(1, {host, status, path, method})
            metric_latency:observe(duration, {host, path})

            -- Atualiza contadores do OTLP exporter (shared dict)
            local otlp = require("otlp_exporter")
            otlp.record(status, path, method, duration)
        end
    }

    upstream backend {
        server ${UPSTREAM_HOST}:${UPSTREAM_PORT};
    }

    server {
        listen 8081;
        server_name _;

        location /nginx_status {
            stub_status on;
            access_log off;
            allow all;
        }

        # Endpoint Prometheus — mantido para debug local e scraping direto
        location /metrics {
            default_type 'text/plain';
            content_by_lua_block {
                prometheus:collect()
            }
        }

        location / {
            proxy_pass http://backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header x-real-ip $remote_addr;
            proxy_set_header x-forward $proxy_add_x_forwarded_for;
            add_header x-proxy-flavour openresty always;
        }
    }
}